<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The launch is always dark, whatever the system or app theme (features-v3 boot-splash),
         so there is one set of styles for day and night. -->
    <!-- Shown while the process starts; removed when Flutter draws its first frame. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Behind the Flutter UI once it runs. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/launch_ground</item>
    </style>
</resources>
