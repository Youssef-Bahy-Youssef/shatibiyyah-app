<?xml version="1.0" encoding="utf-8"?>
<!--
  What Android's automatic backup keeps (Android 11 and older; data_extraction_rules.xml
  says the same for 12 and newer): the student's own data only, user.sqlite (bookmarks
  and notes), with the journal files a database stopped in mid-write leaves beside it.

  Not the preferences: they hold the state of this install (the verse the reader
  is on, the tour, the chosen recording, the downloads), and an app installed
  afresh starts at the first page with the tour. Not the recordings or the copy of
  the content: both come back by themselves, and one recording alone is past the
  25 MB a backup may hold, which made Android skip the whole backup.
-->
<full-backup-content>
    <include domain="file" path="user.sqlite"/>
    <include domain="file" path="user.sqlite-wal"/>
    <include domain="file" path="user.sqlite-journal"/>
</full-backup-content>
