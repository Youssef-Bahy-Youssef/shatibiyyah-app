<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12 and newer; see backup_rules.xml for the reasons. The cloud backup
  keeps the student's bookmarks and notes only. A transfer from one phone to
  another has no rules here, so it copies everything, as the system does by
  default: the student's place, settings and downloaded recordings move with them.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="user.sqlite"/>
        <include domain="file" path="user.sqlite-wal"/>
        <include domain="file" path="user.sqlite-journal"/>
    </cloud-backup>
</data-extraction-rules>
