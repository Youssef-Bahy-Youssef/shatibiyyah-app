<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ system splash: the logo (the adaptive foreground, no tile) on espresso. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/espresso</item>
        <item name="android:windowSplashScreenBackground">@color/espresso</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/espresso</item>
    </style>
</resources>
