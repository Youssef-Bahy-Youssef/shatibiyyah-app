<?xml version="1.0" encoding="utf-8"?>
<!-- «تابع», the binding (ADR 0025). The cover, then the hairline, then one mask for each ink
     (ResumePainter), each tinted with its colour role, and the tap targets over them.

     The colours here are the day and night resources (values/ and values-night/widget_colors.xml),
     so under «تلقائي» the launcher follows the system by itself. With paper or night chosen in
     the app, ResumeWidget sets that theme's cover and colours instead, on
     @layout/widget_resume_fixed (the same file under a second name, so the launcher builds it
     afresh when the choice changes). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="ltr">
    <ImageView
        android:id="@+id/widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_cover" />
    <!-- The hairline under the row: ResumeWidget sets this box's padding to where it lies.
         (A launcher refuses a plain View in a widget, so the line is an empty frame.) -->
    <FrameLayout
        android:id="@+id/widget_rule_box"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <FrameLayout
            android:id="@+id/widget_rule"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/widget_cover_line" />
    </FrameLayout>
    <ImageView
        android:id="@+id/widget_gilt"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:tint="@color/widget_gilt_on_cover" />
    <ImageView
        android:id="@+id/widget_mute"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:tint="@color/widget_cover_mute" />
    <ImageView
        android:id="@+id/widget_ink"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:tint="@color/widget_on_cover" />
    <include layout="@layout/widget_buttons" />
</FrameLayout>
