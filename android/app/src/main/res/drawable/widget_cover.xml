<?xml version="1.0" encoding="utf-8"?>
<!-- The binding's surface. At night the dock's shadow ends in a hairline ring of lapis;
     on paper that colour is clear. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/widget_cover" />
    <stroke android:width="1dp" android:color="@color/widget_cover_ring" />
    <corners android:radius="@dimen/widget_radius" />
</shape>
